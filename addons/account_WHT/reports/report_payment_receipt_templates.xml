<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_receipt_custom_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="account.report_payment_receipt_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_payment_receipt_document_inherit_wht" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[contains(@class,'page')]" position="attributes">
            <attribute name="class" add="th-header-padded" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('page')]" position="inside">
            <t t-set="wht_cert" t-value="o.env['account.wht.certificate'].search(['|', ('payment_id', '=', o.id), ('payment_ids', 'in', [o.id]), ('state', '!=', 'cancel')], limit=1)"/>
            <t t-if="wht_cert">
                <t t-set="wht_amount" t-value="wht_cert.tax_amount"/>
                <t t-set="total_invoice_amount" t-value="o.amount + wht_amount"/>
                <div class="row justify-content-end mt-4">
                    <div class="col-6">
                        <table class="table table-sm text-end">
                            <tr>
                                <td><strong>ยอดรวมก่อนหักภาษี</strong></td>
                                <td><span t-esc="total_invoice_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td><strong>ภาษีหัก ณ ที่จ่าย (WHT)</strong></td>
                                <td><span t-esc="wht_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr class="border-black o_total">
                                <td><strong>ยอดรับชำระสุทธิ</strong></td>
                                <td><span t-esc="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </t>
            <t t-else="">
                <!-- Fallback to checking reconciled moves if certificate is not generated yet -->
                <t t-set="reconciled_moves" t-value="o.reconciled_invoice_ids or (hasattr(o, 'reconciled_bill_ids') and o.reconciled_bill_ids)"/>
                <t t-set="total_invoice_amount" t-value="sum(inv.amount_total for inv in reconciled_moves) if reconciled_moves else o.amount"/>
                <t t-set="wht_amount" t-value="total_invoice_amount - o.amount"/>
                <t t-if="wht_amount &gt; 0.0">
                    <div class="row justify-content-end mt-4">
                        <div class="col-6">
                            <table class="table table-sm text-end">
                                <tr>
                                    <td><strong>ยอดรวมก่อนหักภาษี</strong></td>
                                    <td><span t-esc="total_invoice_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                                <tr>
                                    <td><strong>ภาษีหัก ณ ที่จ่าย (WHT)</strong></td>
                                    <td><span t-esc="wht_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>ยอดรับชำระสุทธิ</strong></td>
                                    <td><span t-esc="o.amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
