<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_tax_invoice" model="report.paperformat">
        <field name="name">Thai Tax Invoice A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>        <!-- เพิ่มพื้นที่ด้านบนเพื่อให้ Header ไม่ติดขอบ -->
        <field name="margin_bottom">60</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">25</field>
        <field name="dpi">96</field>
        <field name="disable_shrinking" eval="False" />
    </record>

    <template id="report_tax_invoice_receipt">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="account.report_invoice_document" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="report_invoice_document_inherit_wht" inherit_id="account.report_invoice_document">
        <xpath expr="//div[contains(@class,'page')]" position="attributes">
            <attribute name="class" add="th-header-padded" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="after">
            <t t-if="o.amount_wht">
                <tr>
                    <td>
                        <strong>ภาษีหัก ณ ที่จ่าย (WHT)
                            <t t-if="o.wht_pay_type == 'normal'">(หัก ณ ที่จ่าย)</t>
                            <t t-if="o.wht_pay_type == 'gross_up_forever'">(ออกให้ตลอด)</t>
                            <t t-if="o.wht_pay_type == 'gross_up_once'">(ออกให้ครั้งเดียว)</t>
                        </strong>
                    </td>
                    <td class="text-end text-right">
                        <span t-field="o.amount_wht" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr class="border-black o_total">
                    <td><strong>ยอดจ่ายสุทธิ (Net Total)</strong></td>
                    <td class="text-end text-right">
                        <span t-field="o.amount_net_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>