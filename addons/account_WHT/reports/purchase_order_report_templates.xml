<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit_wht" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//div[contains(@class,'page')]" position="attributes">
            <attribute name="class" add="th-header-padded" separator=" "/>
        </xpath>
        <xpath expr="//t[@t-call='purchase.document_tax_totals']" position="after">
            <t t-if="o.amount_wht">
                <tr>
                    <td><strong>ภาษีหัก ณ ที่จ่าย (WHT)</strong></td>
                    <td class="text-end text-right">
                        <span t-field="o.amount_wht" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <tr class="border-black o_total">
                    <td><strong>ยอดสั่งซื้อสุทธิ (Net Total)</strong></td>
                    <td class="text-end text-right">
                        <span t-field="o.amount_net_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
            </t>
        </xpath>
    </template>
</odoo>
